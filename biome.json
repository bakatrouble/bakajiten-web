{
    "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
    "files": {
        "includes": [
            "**",
            "!node_modules",
            "!dist",
            "!src/vendor",
            "!src/assets",
            "!components.d.ts",
            "!auto-imports.d.ts"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    },
    "overrides": [
        {
            "includes": [
                "**/*.vue"
            ],
            "linter": {
                "rules": {
                    "correctness": {
                        "noUnusedImports": "off",
                        "noUnusedVariables": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "tests/**"
            ],
            "linter": {
                "rules": {
                    "style": {
                        "noNonNullAssertion": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "src/components/ui/**/*.vue"
            ],
            "linter": {
                "rules": {
                    "style": {
                        "useVueMultiWordComponentNames": "off"
                    }
                }
            }
        }
    ],
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "trailingCommas": "all",
            "semicolons": "always"
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "html": {
        "experimentalFullSupportEnabled": true,
        "formatter": {
            "enabled": true
        }
    }
}
