{
    "name": "bakajiten-web",
    "version": "0.2.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "sync-bindings": "node scripts/sync-bindings.mjs",
        "predev": "npm run sync-bindings",
        "prebuild": "npm run sync-bindings",
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "fetch-data": "node scripts/fetch-data.mjs",
        "format": "biome format --write ./src ./tests ./scripts",
        "lint": "biome lint ./src ./tests ./scripts",
        "check": "biome check --write ./src ./tests ./scripts"
    },
    "dependencies": {
        "@lucide/vue": "^1.59.0",
        "@mdi/js": "^7.4.47",
        "@vueuse/core": "^15.0.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.0",
        "pinia": "^4.1.0",
        "reka-ui": "^2.11.0",
        "shadcn-vue": "^2.8.2",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "vue": "3.5.44"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.5",
        "@vitejs/plugin-vue": "^5.0.0",
        "playwright-core": "^1.64.1",
        "typescript": "6.0.3-bridge.18.tsgo.7.0.2",
        "vite": "^6.0.0",
        "vite-plugin-pwa": "^2.0.0",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.13",
        "workbox-window": "^7.4.1"
    }
}
